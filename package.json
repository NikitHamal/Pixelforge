{
  "name": "pixelforge",
  "version": "2.0.0",
  "private": true,
  "description": "Browser pixel-art studio and procedural game-asset engine: 189 templates, 25 style palettes, atlas packing and engine-ready export. Every sprite is generated at runtime by pure maths \u2014 there are no image assets.",
  "keywords": [
    "pixel-art",
    "sprite",
    "game-assets",
    "sprite-atlas",
    "canvas",
    "procedural",
    "rpg",
    "platformer",
    "tileset",
    "autotile",
    "godot",
    "unity",
    "phaser",
    "tiled",
    "bmfont",
    "palette",
    "no-dependencies"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "verify": "node scripts/verify.js",
    "test": "node scripts/verify.js",
    "gate": "node scripts/check-rpg.js",
    "gate:style": "node scripts/check-style.js",
    "gate:atlas": "node scripts/check-atlas.js",
    "gate:export": "node scripts/check-export.js",
    "gate:docs": "node scripts/check-docs.js",
    "baseline": "node scripts/sprite-hash.js save scripts/hashes-baseline",
    "bench": "node scripts/bench-compare.js",
    "sheet": "node scripts/sheet.js",
    "catalogue": "node scripts/catalogue.js",
    "forge": "node scripts/forge.js",
    "serve": "node scripts/serve.js"
  },
  "dependencies": {},
  "devDependencies": {}
}
