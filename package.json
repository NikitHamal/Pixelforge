{
  "name": "pixelforge",
  "version": "2.0.0",
  "description": "Browser pixel-art studio and procedural game-asset engine. Every sprite is generated at runtime by pure maths \u2014 there are no image assets.",
  "keywords": [
    "pixel-art",
    "sprite",
    "sprite-sheet",
    "game-assets",
    "gamedev",
    "canvas",
    "procedural",
    "rpg",
    "tileset",
    "gif",
    "godot",
    "unity",
    "phaser",
    "love2d",
    "gamemaker",
    "aseprite",
    "zero-dependency"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "verify": "node scripts/verify.js",
    "test": "node scripts/test.js",
    "gate": "node scripts/check-rpg.js",
    "baseline": "node scripts/verify.js --update-baseline",
    "bench": "node scripts/bench-compare.js",
    "sheet": "node scripts/sheet.js",
    "serve": "node scripts/serve.js",
    "cli": "node bin/pixelforge.js",
    "info": "node scripts/info.js"
  },
  "dependencies": {},
  "devDependencies": {},
  "bin": {
    "pixelforge": "bin/pixelforge.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "js/",
    "css/",
    "app/",
    "index.html",
    "studio.html",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikitHamal/Pixelforge.git"
  },
  "bugs": {
    "url": "https://github.com/NikitHamal/Pixelforge/issues"
  },
  "homepage": "https://github.com/NikitHamal/Pixelforge#readme"
}
